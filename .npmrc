manage-package-manager-versions=false
engine-strict=false
# Mirrors apps/web/.npmrc: a pnpm other than the pinned 10.22.0 must warn,
# not fail the build with ERR_PNPM_BAD_PM_VERSION (Hostinger GitHub deploys).
# pnpm <=10 keys here; pnpm >=11 reads devEngines.packageManager.onFail from
# package.json instead (see root package.json).
package-manager-strict-version=false
package-manager-strict=false
