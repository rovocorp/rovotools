{
  "name": "@rovotools/web",
  "version": "0.1.0",
  "private": true,
  "description": "RovoTools Web Application (Next.js + PWA)",
  "packageManager": "pnpm@10.22.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.22.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver"],
    "overrides": {
      "sharp": "0.35.5",
      "basic-ftp": "6.2.3",
      "tinypool": "2.2.0",
      "serialize-javascript": "7.1.2",
      "source-map-js": "1.2.2",
      "fast-uri": "3.1.8",
      "tmp": "0.2.7",
      "brace-expansion": "1.1.21",
      "decode-uri-component": "0.5.0",
      "uuid": "11.1.1",
      "sprintf-js": "1.1.3",
      "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    }
  },
  "scripts": {
    "copy:pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "clean": "rm -rf .next out node_modules"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.84.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "i18next": "^25.4.0",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.3",
    "next": "16.3.8",
    "next-pwa": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^15.4.0",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "babel-loader": "^10.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
