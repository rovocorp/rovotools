# RovoTools static hosting (Apache / Hostinger shared).
# Goal: cut origin hits so mod_evasive / entry-process limits don't 429,
# especially right after deploy when browsers + crawlers refetch everything.
# Every block is guarded by <IfModule> so missing modules never 500.

# No directory listings: /tools/ must serve tools/index.html, never a listing.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Legacy tool URLs -> canonical survivors (were next.config.ts redirects).
  RewriteRule ^tools/emi-calculator/?$ /tools/loan-calculator/ [R=301,L]
  RewriteRule ^tools/loan-payment-calculator/?$ /tools/loan-calculator/ [R=301,L]
  RewriteRule ^tools/vat-calculator/?$ /tools/tax-calculator/ [R=301,L]
  RewriteRule ^tools/character-counter/?$ /tools/word-counter/ [R=301,L]
  RewriteRule ^tools/text-to-pdf/?$ /tools/pdf/pdf-creator/ [R=301,L]
  RewriteRule ^tools/category/converter/?$ /tools/category/calculator/ [R=301,L]
  RewriteRule ^tools/merge-pdf/?$ /tools/pdf/merge-pdf/ [R=301,L]
  RewriteRule ^tools/split-pdf/?$ /tools/pdf/split-pdf/ [R=301,L]
  RewriteRule ^tools/compress-pdf/?$ /tools/pdf/compress-pdf/ [R=301,L]
  RewriteRule ^tools/jpg-to-pdf/?$ /tools/pdf/jpg-to-pdf/ [R=301,L]
  RewriteRule ^tools/pdf-to-jpg/?$ /tools/pdf/pdf-to-jpg/ [R=301,L]
  RewriteRule ^tools/word-to-pdf/?$ /tools/pdf/word-to-pdf/ [R=301,L]
  RewriteRule ^tools/pdf-creator/?$ /tools/pdf/pdf-creator/ [R=301,L]
  RewriteRule ^tools/sign-pdf/?$ /tools/pdf/sign-pdf/ [R=301,L]
  RewriteRule ^tools/pdf-to-word/?$ /tools/pdf/pdf-to-word/ [R=301,L]
  RewriteRule ^tools/pdf-to-excel/?$ /tools/pdf/pdf-to-excel/ [R=301,L]
  RewriteRule ^tools/pdf-extract-text/?$ /tools/pdf/pdf-extract-text/ [R=301,L]
</IfModule>

# Compression: fewer bytes, faster drain of concurrent connections.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caching: hashed _next/static/* is immutable (1y); images/fonts 30d.
# HTML gets a short 5-minute cache window (instead of must-revalidate on
# every view): repeat navigations serve from the visitor's cache with zero
# origin hits, which keeps mod_evasive/entry-process limits quiet on
# throttled shared hosting. Deploys still go live within ~5 minutes, and the
# service-worker update flow refreshes clients anyway.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  # Immutable hashed Next.js assets: cache hard, never revalidate.
  <FilesMatch "^.*$">
    Header unset ETag
  </FilesMatch>
  <LocationMatch "^/_next/static/.*">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>
  # HTML shells: short cache window so repeat views never touch origin
  # (see above); stale copies may serve briefly while revalidating.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  # Keep crawlers light: sitemap/robots revalidate quickly but allow stale.
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>
