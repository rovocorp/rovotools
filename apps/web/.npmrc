manage-package-manager-versions=false
engine-strict=false
# pnpm <=10 version-check knobs (pnpm >=11 replaced them with pmOnFail,
# which .npmrc does NOT read — see devEngines.packageManager in package.json,
# the channel that keeps ERR_PNPM_BAD_PM_VERSION a warning on Hostinger's
# pnpm 12.5.1 build step). Fallback: env pnpm_config_pm_on_fail=warn.
package-manager-strict-version=false
package-manager-strict=false
