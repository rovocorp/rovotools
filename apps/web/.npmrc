manage-package-manager-versions=false
engine-strict=false
# Hostinger's build step has run pnpm 12.5.1 while package.json pins
# pnpm@10.22.0, hard-failing the build with ERR_PNPM_BAD_PM_VERSION.
# Keep the version comparison a warning so `pnpm run build` proceeds.
package-manager-strict-version=false
package-manager-strict=false
