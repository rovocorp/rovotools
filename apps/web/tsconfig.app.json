{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@rovotools/core": ["../../../packages/core/src/index.ts"],
      "@rovotools/calculations": ["../../../packages/calculations/src/index.ts"],
      "@rovotools/validation": ["../../../packages/validation/src/index.ts"],
      "@rovotools/localization": ["../../../packages/localization/src/index.ts"],
      "@rovotools/tools": ["../../../packages/tools/src/index.ts"],
      "@rovotools/types": ["../../../packages/types/src/index.ts"],
      "@rovotools/ui": ["../../../packages/ui/src/index.ts"],
      "@rovotools/config": ["../../../packages/config/src/index.ts"],
      "@rovotools/theme": ["../../../packages/theme/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
