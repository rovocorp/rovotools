{
  "name": "@rovotools/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "RovoTools Mobile Application (React Native + Expo)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "eas build",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf node_modules .expo dist"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rovotools/calculations": "workspace:*",
    "@rovotools/config": "workspace:*",
    "@rovotools/core": "workspace:*",
    "@rovotools/localization": "workspace:*",
    "@rovotools/theme": "workspace:*",
    "@rovotools/tools": "workspace:*",
    "@rovotools/types": "workspace:*",
    "@rovotools/validation": "workspace:*",
    "expo": "~56.0.0",
    "expo-clipboard": "~56.0.0",
    "expo-document-picker": "~56.0.0",
    "expo-file-system": "~56.0.0",
    "expo-image-picker": "~56.0.0",
    "expo-router": "~56.2.0",
    "expo-secure-store": "~56.0.0",
    "expo-sharing": "~56.0.0",
    "expo-splash-screen": "~56.0.0",
    "expo-status-bar": "~56.0.0",
    "i18next": "^25.4.0",
    "mammoth": "^1.12.3",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-i18next": "^15.4.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.13.0",
    "zod": "^3.25.7",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.14",
    "@types/react-native": "0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
