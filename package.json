{
  "name": "rovotools",
  "private": true,
  "version": "0.1.0",
  "description": "RovoTools — Multi-platform tool ecosystem (Web + PWA + Mobile)",
  "scripts": {
    "build": "pnpm build:web",
    "build:all": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:web": "pnpm build:packages && pnpm --filter @rovotools/web build",
    "build:mobile": "pnpm --filter @rovotools/mobile build",
    "start": "pnpm --filter @rovotools/web start",
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "dev:web": "pnpm --filter @rovotools/web dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.0.0"
  },
  "keywords": ["rovotools", "tools", "multi-platform", "web", "mobile", "react-native", "nextjs"]
}
