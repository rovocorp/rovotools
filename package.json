{
  "name": "rovotools",
  "private": true,
  "version": "0.1.0",
  "description": "RovoTools — Multi-platform tool ecosystem (Web + PWA + Mobile)",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:web": "pnpm --filter @rovotools/web build",
    "build:mobile": "pnpm --filter @rovotools/mobile build",
    "dev": "pnpm --parallel --filter './packages/*' dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": ["rovotools", "tools", "multi-platform", "web", "mobile", "react-native", "nextjs"]
}
