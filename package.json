{
  "name": "rovotools",
  "private": true,
  "version": "0.1.0",
  "description": "RovoTools — Multi-platform tool ecosystem (Web + PWA + Mobile)",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:web": "pnpm build:packages && pnpm --filter @rovotools/web build",
    "build:mobile": "pnpm --filter @rovotools/mobile build",
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=12.0.0"
  },
  "keywords": [
    "rovotools",
    "tools",
    "multi-platform",
    "web",
    "mobile",
    "react-native",
    "nextjs"
  ]
}
