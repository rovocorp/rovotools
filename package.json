{
  "name": "rovotools",
  "private": true,
  "version": "0.1.0",
  "description": "RovoTools — Multi-platform tool ecosystem (Web + PWA + Mobile)",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:web": "pnpm build:packages && pnpm --filter @rovotools/web build",
    "deploy:web": "pnpm build:web",
    "build:mobile": "pnpm --filter @rovotools/mobile build",
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "packageManager": "pnpm@10.22.0+sha512-vwSe/plbKPUn/StBrgR0zikYb37cs79UUIe9Yfu+uyv3U2LRMH/aCcLSiOHkmXh6wS1Py2F6l0cYpgUfLu50HA==",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "keywords": [
    "rovotools",
    "tools",
    "multi-platform",
    "web",
    "mobile",
    "react-native",
    "nextjs"
  ]
}
