# dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build outputs
dist/
# pnpm >=11 loader downloads its OS-specific binary next to itself on first
# run — never commit that blob (each machine/host fetches its own platform)
scripts/pnpm/pnpm-native*
.next/
out/
build/
# Expo / native generated outputs (recreated by `expo prebuild` / app builds;
# never commit: caches, splash/icon derivatives, gradle wrapper, keystores)
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
# generated vendored bundles (recreated by prebuild hooks; the tracked
# PWA shell in public/ stays committed by existing practice)
apps/web/public/pdf.worker.min.mjs

# cache
.cache/
.tsbuildinfo
*.tsbuildinfo

# environment
.env
.env.local
.env.development
.env.production

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# OS (Windows)
Desktop.ini
$RECYCLE.BIN/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# testing
coverage/
test-results/
playwright-report/
blob-report
playwright/.auth
test-out.txt
test-output.txt
theme-test.txt

# misc
*.orig
*.bak
*.swp

# ...except the vendored pnpm deploy binary, which must stay committed IN
# FULL (bin + dist payload incl. its bundled node_modules): fresh clones and
# hosts use it with no registry round-trip for the package manager itself.
# This block lives LAST on purpose: gitignore is last-match-wins, and the
# generic patterns above (dist/, build/, node_modules/, .idea/, ...) also
# match NESTED dirs inside the payload — anything placed earlier gets
# re-ignored. The trailing /** re-includes the whole subtree at any depth.
!scripts/pnpm/dist/
!scripts/pnpm/dist/**
