# dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build outputs
dist/
# ...except the vendored pnpm deploy binary, which must stay committed
!scripts/pnpm/dist/
.next/
out/
build/
# Expo / native generated outputs (recreated by `expo prebuild` / app builds;
# never commit: caches, splash/icon derivatives, gradle wrapper, keystores)
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
# generated vendored bundles (recreated by prebuild hooks; the tracked
# PWA shell in public/ stays committed by existing practice)
apps/web/public/pdf.worker.min.mjs

# cache
.cache/
.tsbuildinfo
*.tsbuildinfo

# environment
.env
.env.local
.env.development
.env.production

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# OS (Windows)
Desktop.ini
$RECYCLE.BIN/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# testing
coverage/
test-results/
playwright-report/
blob-report
playwright/.auth
test-out.txt
test-output.txt
theme-test.txt

# misc
*.orig
*.bak
*.swp
