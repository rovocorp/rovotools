{
  "name": "@rovotools/tools",
  "version": "0.1.0",
  "description": "Tool definitions and registry for RovoTools",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rovotools/calculations": "workspace:*",
    "@rovotools/core": "workspace:*",
    "@rovotools/localization": "workspace:*",
    "@rovotools/types": "workspace:*",
    "@rovotools/validation": "workspace:*"
  },
  "devDependencies": {
    "@rovotools/calculations": "workspace:*",
    "@rovotools/core": "workspace:*",
    "@rovotools/localization": "workspace:*",
    "@rovotools/types": "workspace:*",
    "@rovotools/validation": "workspace:*",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "license": "MIT"
}
